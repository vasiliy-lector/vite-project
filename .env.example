# Пример файла окружения для монорепо.
#
# КЛИЕНТ (vite читает client/.env; переменные с префиксом VITE_
# доступны во фронтенд-коде через import.meta.env):
#   VITE_API_URL=http://localhost:3000
#
# БЭКЕНД (node/tsx читают backend/.env через dotenv):
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/vite_app
#   PORT=3000
#
# Без DATABASE_URL (или DATABASE_URL=pglite) бэкенд поднимает встроенную
# PGlite — схема и сид из backend/migrations/0001_init.sql применяются
# автоматически. Для настоящей Postgres: docker compose up -d.
#
# Скопируйте нужные блоки в client/.env и backend/.env.
